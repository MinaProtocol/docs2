{
  "name": "contracts",
  "version": "0.1.0",
  "description": "Smart contract for zkApp tutorial 7: verify a signed oracle response",
  "author": "",
  "license": "Apache-2.0",
  "keywords": [
    "mina-zkapp",
    "mina-zk-app",
    "mina-dapp",
    "zkapp"
  ],
  "type": "module",
  "main": "build/src/index.js",
  "types": "build/src/index.d.ts",
  "scripts": {
    "build": "tsc",
    "buildw": "tsc --watch",
    "format": "prettier --write --ignore-unknown **/*",
    "test": "npm run build && node --test build/src/*.test.js",
    "testw": "npm run build && node --test --watch build/src/*.test.js",
    "lint": "npx eslint src/* --fix"
  },
  "lint-staged": {
    "**/*": [
      "eslint src/* --fix",
      "prettier --write --ignore-unknown"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^9.12.0",
    "eslint-plugin-o1js": "^0.4.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2"
  },
  "peerDependencies": {
    "o1js": "^3.0.0"
  },
  "engines": {
    "node": ">=22.19.5"
  }
}
